{
  "name": "nfe-nfce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright automation for downloading files from the SIATWeb portal of SEFAZ-PI",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --grep-invert @on-demand",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:scheduling": "playwright test e2e/nfe-export-scheduling.spec.ts",
    "test:scheduling:issuer": "playwright test e2e/nfe-export-issuer-scheduling.spec.ts",
    "test:scheduling:nfce": "playwright test e2e/nfce-export-issuer-scheduling.spec.ts",
    "test:scheduling:nfce:all-status": "playwright test e2e/nfce-export-issuer-all-status-scheduling.spec.ts",
    "test:headed": "playwright test --headed --grep-invert @on-demand",
    "test:ui": "playwright test --ui --grep-invert @on-demand",
    "test:report": "playwright show-report",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "dotenv": "18.0.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
