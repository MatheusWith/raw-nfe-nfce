# Address of the portal under test. Required, with no default.
E2E_BASE_URL=

# Origin of the certificate SSO host the portal delegates to. The A1 is scoped to
# this origin only, so it is never offered to any other host.
E2E_CERT_SSO_ORIGIN=

# Absolute path to the A1 digital certificate file (.pfx or .p12), outside the repository.
E2E_CERT_PATH=

# Password of the A1 digital certificate.
E2E_CERT_PASSWORD=

# Origin of the SIATWeb system the traversal arrives at. The portal and the
# destination system share the name "SIATWeb" but are different applications on
# different origins, so the destination needs its own variable. Required, with no
# default.
E2E_SIATWEB_SYSTEM_ORIGIN=

# Tax inscription of the company the session has to represent. The portal only
# lets a session cross into the legacy system and on to the SIATWeb system when
# it represents a company entitled to it. Required, with no default, and never
# written into versioned code: it is the fiscal identifier of a real company.
E2E_COMPANY_INSCRIPTION=

# Portal credentials. Only needed for the CPF/CNPJ form, which this automation
# does not use: it authenticates with the certificate above.
E2E_USER=
E2E_PASSWORD=

# State inscriptions whose NF-e export is to be scheduled, separated by commas,
# in the order they should be scheduled. Punctuation and spaces are removed on
# reading, so the number pasted as the screen shows it and the bare digits both
# work. Required, with no default, and never written into versioned code: a state
# inscription is the fiscal identifier of a real company.
#
# Reused, unchanged, by the NFC-e flow (pnpm test:scheduling:nfce): the same list
# is scheduled through the other menu branch. There is no NFC-e variable.
E2E_NFE_EXPORT_INSCRIPTIONS=

# Emission period every inscription above is scheduled for, in dd/mm/yyyy. The
# same pair covers the whole list. Required, with no default, and never written
# into versioned code: the period is real fiscal data.
#
# Reused, unchanged, by the NFC-e flow (pnpm test:scheduling:nfce), under the
# same reasoning: one period, two screens. There is no NFC-e variable.
E2E_NFE_EXPORT_EMISSION_START=
E2E_NFE_EXPORT_EMISSION_END=

# Directory where downloaded files are saved.
E2E_DOWNLOAD_DIR=